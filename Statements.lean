import D2RelationGap.FoxFilling
import D2RelationGap.DeficiencyZero

/-!
# A concrete integral relation gap and deficiency zero

This is the reader-facing verification entry point. Proofs are imported above;
the statements below expose their actual objects and quantifiers rather than
only asserting an opaque `Target`. No new axioms or proof placeholders are used.

The free generators are `x1, a1, x2, a2, s`. The six relators are
`x1*a1*x1⁻¹*a1⁻⁴`, `x2*a2*x2⁻¹*a2⁻³`, `x1*a2⁻¹³`,
`s*x2*s⁻¹*a1⁻⁵`, `x1²`, and `x2³`.

`word` converts the displayed signed-letter lists to elements of the free group.
The generator type is the five-constructor `D2RelationGap.Gen`, not a surrogate
group. The bridge checks below ensure this displayed presentation and its
kernel are definitionally the exact objects used by the imported proofs.
-/

namespace RelationGapProblem

noncomputable section

open D2RelationGap (Gen Letter pos neg)

abbrev F := FreeGroup Gen

/-- Interpret a signed letter, then multiply the resulting free-group elements. -/
def word (letters : List Letter) : F :=
  (letters.map (fun l =>
    if l.positive then FreeGroup.of l.gen else (FreeGroup.of l.gen)⁻¹)).prod

def r₁ : F := word ([pos .x1, pos .a1, neg .x1] ++ List.replicate 4 (neg .a1))
def r₂ : F := word ([pos .x2, pos .a2, neg .x2] ++ List.replicate 3 (neg .a2))
def r₃ : F := word ([pos .x1] ++ List.replicate 13 (neg .a2))
def r₄ : F := word ([pos .s, pos .x2, neg .s] ++ List.replicate 5 (neg .a1))
def t₁ : F := word (List.replicate 2 (pos .x1))
def t₂ : F := word (List.replicate 3 (pos .x2))

def relators : Set F := {r₁, r₂, r₃, r₄} ∪ {t₁, t₂}

/-- The concrete six-relator quotient of the rank-five free group. -/
abbrev G := PresentedGroup relators
abbrev quotientMap : F →* G := PresentedGroup.mk relators
abbrev N : Subgroup F := quotientMap.ker

/-- The additive abelianization of the actual kernel, and the integral group ring. -/
abbrev M := Additive (Abelianization N)
abbrev ZG := MonoidAlgebra ℤ G

theorem presentation_matches_proof : relators = D2RelationGap.Targets.quotientRelations := by
  rfl

theorem kernel_matches_proof : N = D2RelationGap.Targets.N := by
  rfl

-- Use the action constructed from conjugation in the imported proof, not an
-- arbitrary module structure whose generator count happens to be four.
local instance : Module ZG M := D2RelationGap.RelationModule.relationModule

/-- The action is the canonical conjugation action: [f] acts on [n] by [fnf⁻¹]. -/
theorem canonical_conjugation_action :
    ∀ (f : F) (n n' : N), (n' : F) = f * (n : F) * f⁻¹ →
      (MonoidAlgebra.single (quotientMap f) (1 : ℤ) : ZG) •
        Additive.ofMul (Abelianization.of n) = Additive.ofMul (Abelianization.of n') := by
  exact D2RelationGap.FoxFilling.integral_relation_gap.1

/-- For this epimorphism, the relation module needs exactly four ZG-generators,
while its kernel needs exactly five normal generators in the rank-five free group.
All minimality quantifiers are explicit; no minimum over an empty set is used. -/
theorem integral_relation_gap :
    (∃ v : Fin 4 → M, Submodule.span ZG (Set.range v) = ⊤) ∧
    (∀ k : ℕ, (∃ v : Fin k → M, Submodule.span ZG (Set.range v) = ⊤) → 4 ≤ k) ∧
    (∃ v : Fin 5 → F, Subgroup.normalClosure (Set.range v) = N) ∧
    (∀ k : ℕ, (∃ v : Fin k → F, Subgroup.normalClosure (Set.range v) = N) → 5 ≤ k) := by
  have h := D2RelationGap.FoxFilling.integral_relation_gap
  exact ⟨h.2.1, h.2.2.1, h.2.2.2.1, h.2.2.2.2⟩

/-- Deficiency zero is global, not just a count for the displayed presentation:
there is a 5-generator/5-relator presentation, and every finite epimorphism
onto G whose kernel is normally generated by k elements has m ≤ k. -/
theorem deficiency_zero :
    (∃ v : Fin 5 → F, Subgroup.normalClosure (Set.range v) = N) ∧
    ∀ (m k : ℕ) (q : FreeGroup (Fin m) →* G), Function.Surjective q →
      (∃ v : Fin k → FreeGroup (Fin m),
        Subgroup.normalClosure (Set.range v) = q.ker) → m ≤ k := by
  exact D2RelationGap.DeficiencyZero.deficiency_zero

end
end RelationGapProblem

#check RelationGapProblem.canonical_conjugation_action
#check RelationGapProblem.integral_relation_gap
#check RelationGapProblem.deficiency_zero
#print axioms RelationGapProblem.canonical_conjugation_action
#print axioms RelationGapProblem.integral_relation_gap
#print axioms RelationGapProblem.deficiency_zero
